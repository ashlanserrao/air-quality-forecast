# Keep the build context small and the image clean.
.venv310/
.venv/
__pycache__/
*.pyc
.git/
.github/
.pytest_cache/

# Dev-only data and artifacts not needed at runtime.
data/raw/
data/knowledge_base/        # PDFs are only for ingestion; runtime reads chroma_db
data/processed/*.csv
!data/processed/pm25_daily_final.csv   # the UI history chart needs this one
eval/
tests/
scripts/
notebooks/
*.ipynb

# Secrets and local env — never bake into an image.
.env
src/.env
*.env
