# Keep the build context small and the image clean.
# NOTE: .dockerignore does NOT support inline (end-of-line) comments — a '#'
# only starts a comment at the beginning of a line. Keep comments on their own
# lines so patterns aren't corrupted by trailing text.
.venv310/
.venv/
__pycache__/
*.pyc
.git/
.github/
.pytest_cache/

# Dev-only data and artifacts not needed at runtime.
data/raw/
# PDFs are only for ingestion; runtime reads chroma_db
data/knowledge_base/
# Exclude all processed CSVs...
data/processed/*.csv
# ...except this one — the UI history chart needs it.
!data/processed/pm25_daily_final.csv
eval/
tests/
scripts/
notebooks/
*.ipynb

# Secrets and local env — never bake into an image.
.env
src/.env
*.env
